# ==============================================================
# NexusFlow – Visual IoT Telemetry & Rule Engine
# Environment Configuration Template (.env.example)
# ==============================================================

# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/nexusflow
# For MongoDB Atlas Cloud:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexusflow?retryWrites=true&w=majority

# JWT & Authentication Secret
JWT_SECRET=replace-with-a-long-random-secret-before-running-the-backend

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# IoT Edge Gateway Settings
MQTT_BROKER_URL=mqtt://localhost:1883
EDGE_HEARTBEAT_INTERVAL_MS=3000
TELEMETRY_SAMPLE_RATE_MS=500

# Notification Services (Optional / Mock Mode by default)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
